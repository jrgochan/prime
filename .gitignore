# ============================================
# The Cathedral — .gitignore
# ============================================

# ── Lean 4 / Lake ──
proofs/.lake/
proofs/lake-packages/
*.olean
*.ilean
*.trace

# ── Rust ──
**/target/
**/*.rs.bk
Cargo.lock
# Note: Cargo.lock in library crates should be ignored;
# keep it for binary crates if desired

# ── Node.js / Next.js ──
**/node_modules/
**/.next/
**/.turbo/
**/.vercel/
**/dist/
**/out/

# ── Python ──
**/__pycache__/
**/*.pyc
**/*.pyo
**/venv/
**/.venv/
**/.env
*.egg-info/

# ── WASM ──
**/*.wasm
!tools/hyperzeta-viewport/public/wasm/*.wasm

# ── LaTeX build artifacts ──
# (PDFs are excluded via papers/.gitignore;
#  results/*.log files are experiment data, not build artifacts)
**/*.aux
**/*.log
!experiments/**/*.log
!results/**/*.log
**/*.toc
**/*.out
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.bbl
**/*.blg
**/*.nav
**/*.snm
**/*.vrb
**/*.idx
**/*.ilg
**/*.ind

# ── Compiled objects / shared libraries ──
*.o
*.so
*.dylib
*.dll
*.a

# ── Binary data / caches ──
**/*.bin
experiments/cache/
experiments/.cache/

# ── Large data files ──
# HDF5 Gram matrix caches (up to 400MB)
**/*.h5
**/*.hdf5

# Large experiment results (TSV/CSV data dumps)
experiments/**/results/**/*.tsv
experiments/**/results_pointwise/**/*.tsv
experiments/**/results/**/*.csv

# Large JSON results (witness scans, certificates)
experiments/**/results/**/*.json
# Exception: small JSON config/certificate files are ok
!experiments/**/results/**/*config*.json
!experiments/cache/certificates/*.json

# Legacy context dumps
docs/exports/**/*.txt
docs/exports/archive/

# Large image renders
docs/hyperzeta-viewport/*.png

# Visualizer generated data (regenerable)
visualizer/public/data/*.json

# ── macOS ──
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ── Linux ──
*~
*.swp
*.swo

# ── IDE / Editor ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ── Debug / build logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Miscellaneous ──
*.tmp
*.bak
*.orig
.env.local
.env.*.local
results/**/*.tsv
results/**/*.json
# Lock files (regenerable)
**/package-lock.json
docs/exports/parts-legacy/
tools/**/results/**/*.jsonl
