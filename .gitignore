# ============================================
# The Cathedral — .gitignore
# ============================================

# Lean 4 / Lake build artifacts
proofs/.lake/
proofs/lake-packages/
*.olean

# Rust build artifacts (experiments + tools)
**/target/

# Node.js (visualizer + tools)
**/node_modules/
**/.next/
**/.turbo/

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/venv/
**/.env

# macOS
.DS_Store
**/.DS_Store

# Editor artifacts
*.swp
*.swo
*~
.vscode/
.idea/

# Build logs
npm-debug.log*
yarn-debug.log*

# LaTeX build artifacts (PDFs are committed intentionally)
papers/*.aux
papers/*.log
papers/*.out
papers/*.toc
papers/*.fls
papers/*.fdb_latexmk
papers/*.synctex.gz

# Cached binary data (Gram matrices, etc.)
experiments/cache/
experiments/.cache/
**/*.bin
