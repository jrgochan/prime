# ============================================
# The Cathedral — .gitignore
# ============================================

# ── Lean 4 / Lake ──
proofs/.lake/
proofs/lake-packages/
*.olean
*.ilean
*.trace

# ── Rust ──
**/target/
**/*.rs.bk

# ── Node.js / Next.js ──
**/node_modules/
**/.next/
**/.turbo/
**/.vercel/
**/dist/
**/out/
**/package-lock.json

# ── Python ──
**/__pycache__/
**/*.pyc
**/*.pyo
**/venv/
**/.venv/
**/.env
*.egg-info/

# ── WASM ──
**/*.wasm

# ── LaTeX build artifacts ──
**/*.aux
**/*.log
!experiments/**/*.log
**/*.toc
**/*.out
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.bbl
**/*.blg
**/*.nav
**/*.snm
**/*.vrb
**/*.idx
**/*.ilg
**/*.ind

# ── Compiled objects / shared libraries ──
*.o
*.so
*.dylib
*.dll
*.a

# ── Large binary data ──
**/*.bin
**/*.h5
**/*.hdf5
experiments/cache/
experiments/.cache/

# ── Legacy context dumps (large text exports) ──
docs/exports/**/*.txt
docs/exports/archive/
docs/exports/parts-legacy/

# ── macOS ──
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ── Linux ──
*~
*.swp
*.swo

# ── IDE / Editor ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ── Debug / build logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Miscellaneous ──
*.tmp
*.bak
*.orig
.env.local
.env.*.local

