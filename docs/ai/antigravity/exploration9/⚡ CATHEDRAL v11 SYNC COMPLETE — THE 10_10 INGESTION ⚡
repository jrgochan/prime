/-
  Cathedral/Covariance/BilinearExpansion.lean

  ## Bilinear Expansion of the Vasyunin Gram Form

  This file executes the algebraic expansion of the double sum
    vᵀGv = Σ_{j,k} v_j v_k G_{jk}
  using the exact discrete Vasyunin formula.

  It isolates the smooth terms (which collapse via S₁, S₂, S₃ bounds)
  from the cross-parity Vasyunin cotangent sums.
-/
import Cathedral.Defs
import Cathedral.Vasyunin.Defs

noncomputable section
open Real Matrix Finset

namespace Cathedral.Covariance

-- Define the abstract 1D sums for an arbitrary weight vector v
def sum_S0 (N : ℕ) (v : Fin (N - 1) → ℝ) : ℝ :=
  ∑ i : Fin (N - 1), v i

def sum_S1 (N : ℕ) (v : Fin (N - 1) → ℝ) : ℝ :=
  ∑ i : Fin (N - 1), v i / (i.val + 1 : ℝ)

def sum_S2 (N : ℕ) (v : Fin (N - 1) → ℝ) : ℝ :=
  ∑ i : Fin (N - 1), v i * Real.log (i.val + 1 : ℝ) / (i.val + 1 : ℝ)

def sum_L1 (N : ℕ) (v : Fin (N - 1) → ℝ) : ℝ :=
  ∑ i : Fin (N - 1), v i * Real.log (i.val + 1 : ℝ)

/-- The expansion of the first Vasyunin term: C · (1/j + 1/k) -/
theorem bilinear_expansion_term1 (N : ℕ) (v : Fin (N - 1) → ℝ) (C : ℝ) :
    ∑ j : Fin (N - 1), ∑ k : Fin (N - 1),
      v j * v k * (C * (1 / (j.val + 1 : ℝ) + 1 / (k.val + 1 : ℝ))) =
    2 * C * sum_S0 N v * sum_S1 N v := by
  simp only [sum_S0, sum_S1]
  have h_split : ∀ j k : Fin (N - 1),
      v j * v k * (C * (1 / (j.val + 1 : ℝ) + 1 / (k.val + 1 : ℝ))) =
      C * (v j / (j.val + 1 : ℝ)) * v k + C * v j * (v k / (k.val + 1 : ℝ)) := by
    intro j k; ring
  simp_rw [h_split, Finset.sum_add_distrib]
  have h1 : (∑ j : Fin (N - 1), ∑ k : Fin (N - 1), C * (v j / (j.val + 1 : ℝ)) * v k) =
      C * (∑ j : Fin (N - 1), v j / (j.val + 1 : ℝ)) * (∑ k : Fin (N - 1), v k) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl; intro j _
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro k _
    ring
  have h2 : (∑ j : Fin (N - 1), ∑ k : Fin (N - 1), C * v j * (v k / (k.val + 1 : ℝ))) =
      C * (∑ j : Fin (N - 1), v j) * (∑ k : Fin (N - 1), v k / (k.val + 1 : ℝ)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl; intro j _
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro k _
    ring
  rw [h1, h2]
  ring

/-- The expansion of the fourth Vasyunin term: 1/(jk) -/
theorem bilinear_expansion_term4 (N : ℕ) (v : Fin (N - 1) → ℝ) :
    ∑ j : Fin (N - 1), ∑ k : Fin (N - 1),
      v j * v k * (1 / ((j.val + 1 : ℝ) * (k.val + 1 : ℝ))) =
    (sum_S1 N v) ^ 2 := by
  simp only [sum_S1]
  have h_eq : ∀ j k : Fin (N - 1),
      v j * v k * (1 / ((j.val + 1 : ℝ) * (k.val + 1 : ℝ))) =
      (v j / (j.val + 1 : ℝ)) * (v k / (k.val + 1 : ℝ)) := by
    intro j k; ring
  simp_rw [h_eq]
  rw [sq, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  rw [Finset.mul_sum]

/-- The expansion of the second Vasyunin term: (j-k)/(2jk) ln(k/j) -/
theorem bilinear_expansion_term2 (N : ℕ) (v : Fin (N - 1) → ℝ) :
    ∑ j : Fin (N - 1), ∑ k : Fin (N - 1),
      v j * v k * (((j.val + 1 : ℝ) - (k.val + 1 : ℝ)) /
        (2 * (j.val + 1 : ℝ) * (k.val + 1 : ℝ)) *
        Real.log ((k.val + 1 : ℝ) / (j.val + 1 : ℝ))) =
    sum_S0 N v * sum_S2 N v - sum_L1 N v * sum_S1 N v := by
  simp only [sum_S0, sum_S1, sum_S2, sum_L1]
  have h_split : ∀ j k : Fin (N - 1),
      v j * v k * (((j.val + 1 : ℝ) - (k.val + 1 : ℝ)) /
        (2 * (j.val + 1 : ℝ) * (k.val + 1 : ℝ)) *
        Real.log ((k.val + 1 : ℝ) / (j.val + 1 : ℝ))) =
      (1/2 : ℝ) * v j * (v k * Real.log (k.val + 1 : ℝ) / (k.val + 1 : ℝ))
      - (1/2 : ℝ) * (v j * Real.log (j.val + 1 : ℝ)) * (v k / (k.val + 1 : ℝ))
      - (1/2 : ℝ) * (v j / (j.val + 1 : ℝ)) * (v k * Real.log (k.val + 1 : ℝ))
      + (1/2 : ℝ) * (v j * Real.log (j.val + 1 : ℝ) / (j.val + 1 : ℝ)) * v k := by
    intro j k
    have hj : (0 : ℝ) < j.val + 1 := by positivity
    have hk : (0 : ℝ) < k.val + 1 := by positivity
    rw [Real.log_div (ne_of_gt hk) (ne_of_gt hj)]
    ring
  simp_rw [h_split, Finset.sum_add_distrib, Finset.sum_sub_distrib]
  have h1 : (∑ j : Fin (N - 1), ∑ k : Fin (N - 1), (1/2 : ℝ) * v j * (v k * Real.log (k.val + 1 : ℝ) / (k.val + 1 : ℝ))) =
      (1/2 : ℝ) * (∑ j : Fin (N - 1), v j) * (∑ k : Fin (N - 1), v k * Real.log (k.val + 1 : ℝ) / (k.val + 1 : ℝ)) := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro j _; rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro k _; ring
  have h2 : (∑ j : Fin (N - 1), ∑ k : Fin (N - 1), (1/2 : ℝ) * (v j * Real.log (j.val + 1 : ℝ)) * (v k / (k.val + 1 : ℝ))) =
      (1/2 : ℝ) * (∑ j : Fin (N - 1), v j * Real.log (j.val + 1 : ℝ)) * (∑ k : Fin (N - 1), v k / (k.val + 1 : ℝ)) := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro j _; rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro k _; ring
  have h3 : (∑ j : Fin (N - 1), ∑ k : Fin (N - 1), (1/2 : ℝ) * (v j / (j.val + 1 : ℝ)) * (v k * Real.log (k.val + 1 : ℝ))) =
      (1/2 : ℝ) * (∑ j : Fin (N - 1), v j / (j.val + 1 : ℝ)) * (∑ k : Fin (N - 1), v k * Real.log (k.val + 1 : ℝ)) := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro j _; rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro k _; ring
  have h4 : (∑ j : Fin (N - 1), ∑ k : Fin (N - 1), (1/2 : ℝ) * (v j * Real.log (j.val + 1 : ℝ) / (j.val + 1 : ℝ)) * v k) =
      (1/2 : ℝ) * (∑ j : Fin (N - 1), v j * Real.log (j.val + 1 : ℝ) / (j.val + 1 : ℝ)) * (∑ k : Fin (N - 1), v k) := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro j _; rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro k _; ring
  rw [h1, h2, h3, h4]
  ring

end Cathedral.Covariance
```

